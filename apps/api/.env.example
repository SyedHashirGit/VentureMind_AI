APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Firebase Realtime Database
FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com/
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccount.json

# Gemini
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# Breeth
BREETH_API_KEY=replace_me
BREETH_BASE_URL=https://api.thebreeth.com

# Valkey (local Docker with valkey-search)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USE_TLS=false
VALKEY_PASSWORD=

SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_THRESHOLD=0.15
RATE_LIMIT_PER_MIN=30
